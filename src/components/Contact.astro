---
import { site } from '../data/site';

const socialLinks = [
  { key: 'github', label: 'GitHub' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'medium', label: 'Medium' },
  { key: 'towardsDataScience', label: 'Towards Data Science' },
  { key: 'twitter', label: 'Twitter' },
] as const;

const links = socialLinks
  .map((s) => ({ ...s, url: (site.socials as Record<string, string>)[s.key] }))
  .filter((s) => s.url);
---

<section id="contact" class="section">
  <div class="wrap contact reveal">
    <p class="eyebrow">contact</p>
    <h2 class="headline">
      Let's build something<br />
      <span class="gradient-text">worth shipping.</span>
    </h2>
    <p class="sub">
      Hiring, collaborating, or just curious? Send a note — including a tailored
      CV on request. I read every message and reply personally.
    </p>

    <form
      class="form"
      data-access-key={site.contactAccessKey}
      aria-label="Contact form"
      novalidate
    >
      <!-- honeypot: humans never see or fill this -->
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

      <div class="row">
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>

      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="4" required></textarea>
      </div>

      <button type="submit" class="submit">
        <span class="submit-label">Send message</span>
      </button>

      <p class="form-status" role="status" aria-live="polite"></p>
    </form>

    <ul class="socials">
      {
        links.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel="noopener">
              {l.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .headline {
    font-size: var(--fs-display);
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }
  .sub {
    color: var(--muted);
    font-size: var(--fs-body);
    max-width: 48ch;
    margin: 0 0 2.75rem;
  }

  .form {
    width: 100%;
    max-width: 560px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  label {
    font-family: var(--mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }
  input,
  textarea {
    font-family: var(--body);
    font-size: var(--fs-body);
    color: var(--ink);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.8rem 0.95rem;
    width: 100%;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }
  textarea {
    resize: vertical;
    min-height: 120px;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--bg-elev-2);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  .field.invalid input,
  .field.invalid textarea {
    border-color: #f0787f;
  }

  .submit {
    align-self: flex-start;
    margin-top: 0.4rem;
    font-family: var(--body);
    font-size: var(--fs-body);
    font-weight: 600;
    color: #06121a;
    background: var(--grad);
    border: none;
    border-radius: 999px;
    padding: 0.85rem 1.75rem;
    cursor: pointer;
    box-shadow: 0 8px 30px -10px var(--accent-glow);
    transition:
      transform 0.15s ease,
      box-shadow 0.25s ease,
      opacity 0.2s ease;
  }
  .submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px -10px var(--accent-glow);
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .form-status {
    font-family: var(--mono);
    font-size: var(--fs-sm);
    margin: 0.2rem 0 0;
    min-height: 1.2em;
  }
  .form-status.ok {
    color: var(--accent);
  }
  .form-status.err {
    color: #f0787f;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
  }
  .socials a {
    font-size: var(--fs-sm);
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .socials a:hover {
    color: var(--ink);
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
    }
    .submit {
      align-self: stretch;
      text-align: center;
    }
  }
</style>

<script>
  const form = document.querySelector('.form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('.form-status') as HTMLParagraphElement;
    const button = form.querySelector('.submit') as HTMLButtonElement;
    const label = form.querySelector('.submit-label') as HTMLSpanElement;
    const accessKey = form.dataset.accessKey ?? '';
    const configured = accessKey && !accessKey.startsWith('YOUR_');

    const setStatus = (msg: string, kind: '' | 'ok' | 'err') => {
      status.textContent = msg;
      status.className = 'form-status' + (kind ? ' ' + kind : '');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('', '');

      // mark invalid fields (native validity, styled inline)
      let firstInvalid: HTMLElement | null = null;
      form.querySelectorAll('input, textarea').forEach((el) => {
        const input = el as HTMLInputElement;
        const wrap = input.closest('.field');
        if (input.name === 'botcheck') return;
        if (!input.checkValidity()) {
          wrap?.classList.add('invalid');
          if (!firstInvalid) firstInvalid = input;
        } else {
          wrap?.classList.remove('invalid');
        }
      });
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        setStatus('Please fill in the required fields.', 'err');
        return;
      }

      if (!configured) {
        setStatus('Form isn’t connected yet — add a Web3Forms access key in site.ts.', 'err');
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      const payload = {
        access_key: accessKey,
        subject: `Portfolio contact from ${data.name || 'someone'}`,
        from_name: 'Portfolio site',
        ...data,
      };

      button.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          form.reset();
          setStatus('Thanks — your message is on its way. I’ll reply soon.', 'ok');
        } else {
          setStatus(json.message || 'Something went wrong. Please email me instead.', 'err');
        }
      } catch {
        setStatus('Network error. Please try again, or reach me on LinkedIn.', 'err');
      } finally {
        button.disabled = false;
        label.textContent = 'Send message';
      }
    });

    // clear the invalid outline as the user fixes a field
    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => el.closest('.field')?.classList.remove('invalid'));
    });
  }
</script>
