---
import { site } from '../data/site';
---

<section id="top" class="hero">
  <canvas class="field" aria-hidden="true"></canvas>
  <div class="grid-overlay" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <h1 class="name">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>

    <ul class="stack" role="list" aria-label="Core skills">
      {site.coreStack.map((t) => <li>{t}</li>)}
    </ul>

    <ul class="stats" role="list">
      {
        site.stats.map((s) => (
          <li>
            <span class="stat-value gradient-text">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <a href="#work" class="scroll-hint" aria-label="Scroll to work">
    <span>scroll</span>
    <span class="chev" aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .grid-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, transparent 40%, var(--bg) 78%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 64px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 64px 100%;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 35%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 35%, #000 30%, transparent 75%);
    opacity: 0.5;
  }

  .hero-inner {
    padding-block: 6rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .name {
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .tagline {
    font-size: var(--fs-lead);
    color: var(--muted);
    max-width: 52ch;
    margin: 1.25rem 0 0;
    line-height: 1.5;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .stack li {
    font-family: var(--mono);
    font-size: var(--fs-label);
    color: var(--ink);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-elev);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .stack li:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.75rem 3rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-value {
    font-family: var(--display);
    font-size: clamp(1.7rem, 3.8vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stat-label {
    font-family: var(--mono);
    font-size: var(--fs-label);
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .chev {
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }
  @media (max-width: 560px) {
    .scroll-hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chev {
      animation: none;
    }
  }
</style>

<script>
  // ── Embedding point-field: drifting cloud that brightens near cursor ──
  const canvas = document.querySelector('.field') as HTMLCanvasElement | null;
  if (canvas) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d')!;
    let w = 0,
      h = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let pts: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
    const mouse = { x: -9999, y: -9999 };

    function resize() {
      w = canvas!.offsetWidth;
      h = canvas!.offsetHeight;
      canvas!.width = w * dpr;
      canvas!.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(140, Math.floor((w * h) / 12000));
      pts = Array.from({ length: count }, (_, i) => ({
        x: (i * 97) % w,
        y: (i * 53) % h,
        vx: (((i * 31) % 20) - 10) / 260,
        vy: (((i * 17) % 20) - 10) / 260,
        r: 0.8 + ((i * 13) % 12) / 10,
      }));
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      for (const p of pts) {
        if (!reduce) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0) p.x = w;
          if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h;
          if (p.y > h) p.y = 0;
        }
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const near = Math.max(0, 1 - dist / 160);
        const alpha = 0.12 + near * 0.75;
        const t = p.y / h;
        const R = Math.round(110 + t * 73);
        const G = Math.round(231 - t * 83);
        const B = Math.round(240 + t * 6);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r + near * 1.6, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${R},${G},${B},${alpha})`;
        ctx.fill();

        if (near > 0.15) {
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.strokeStyle = `rgba(${R},${G},${B},${near * 0.18})`;
          ctx.lineWidth = 0.6;
          ctx.stroke();
        }
      }
      if (!reduce) requestAnimationFrame(draw);
    }

    window.addEventListener('resize', resize);
    window.addEventListener(
      'pointermove',
      (e) => {
        const rect = canvas!.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      },
      { passive: true }
    );
    window.addEventListener('pointerleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    resize();
    draw();
    if (reduce) draw();
  }
</script>
