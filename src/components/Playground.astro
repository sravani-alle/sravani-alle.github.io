---
import { site } from '../data/site';

const items = site.playground;
---

<section id="playground" class="section">
  <div class="wrap">
    <p class="eyebrow reveal">playground</p>
    <h2 class="section-title reveal">Built for fun. Shipped for real.</h2>
    <p class="lede reveal">
      Weekend experiments vibe-coded with AI - small, useful, and all live.
    </p>

    <div class="grid">
      {
        items.map((p) => (
          <a class="card reveal" href={p.url} target="_blank" rel="noopener">
            <div class="card-head">
              <h3 class="title">{p.title}</h3>
              <span class="arrow" aria-hidden="true">↗</span>
            </div>
            <p class="blurb">{p.blurb}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lede {
    color: var(--muted);
    margin: -1.75rem 0 2.5rem;
    max-width: 52ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    background: var(--bg-elev-2);
  }
  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .title {
    font-size: var(--fs-card-title);
    line-height: 1.25;
  }
  .arrow {
    color: var(--muted);
    font-size: 1.1rem;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }
  .card:hover .arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }
  .blurb {
    color: var(--muted);
    font-size: var(--fs-body);
    margin: 0.75rem 0 0;
  }
</style>
