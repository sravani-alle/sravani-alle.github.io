---
import { site } from '../data/site';
---

<section id="skills" class="section">
  <div class="wrap">
    <p class="eyebrow reveal">stack</p>
    <h2 class="section-title reveal">The tools I reach for.</h2>

    <div class="masonry">
      {
        site.skills.map((s) => (
          <div class="group reveal">
            <h3 class="group-name">{s.group}</h3>
            <ul>
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .masonry {
    column-width: 250px;
    column-gap: 1.25rem;
  }
  .group {
    break-inside: avoid;
    /* keep a card whole within a column */
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: 1.25rem;
    padding: 1.5rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .group:hover {
    border-color: var(--line-strong);
    background: var(--bg-elev-2);
  }
  .group-name {
    font-family: var(--mono);
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .group li {
    color: var(--muted);
    font-size: var(--fs-body);
    transition: color 0.2s ease;
  }
  .group:hover li {
    color: var(--ink);
  }
</style>
